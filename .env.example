# Copy this file to .env (in the same folder as the notebook) and fill it in.
# .env is git-ignored: never commit it, never paste it into a chat or a shared doc.
#
# Use the SAME values in Wokwi's config.py, so the notebook and the simulated
# device meet on the same broker and the same device ID.

# Broker (from your instructor, or your own free MQTT broker account)
MQTT_HOST=your-broker-host
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USER=
MQTT_PASS=

# Your device's name: pick something unique, like wokwi-yourname
PICO_ID=change-me

# No broker account? This public test broker needs no login (anyone can see
# the messages, which are only colors and sensor numbers):
#   MQTT_HOST=broker.hivemq.com   and leave MQTT_USER / MQTT_PASS empty
